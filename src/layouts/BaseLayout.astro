---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transparentNav?: boolean;
  noNav?: boolean;
  noPadding?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  transparentNav = false,
  noNav = false,
  noPadding = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}

    <!-- KaTeX for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66pr4hX" crossorigin="anonymous" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {!noNav && <Nav transparent={transparentNav} />}
    <main class:list={[!noPadding && !noNav && 'pt-[52px]']}>
      <slot />
    </main>

    <!-- Footer -->
    {!noNav && (
      <footer class="border-t border-[var(--color-border)] py-10 mt-20">
        <div class="page-container flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-[var(--color-text-muted)]">
          <p>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
          <div class="flex items-center gap-4">
            <a href={SITE.github} target="_blank" rel="noopener" class="hover:text-[var(--color-accent)] transition-colors">GitHub</a>
            <a href={`mailto:${SITE.email}`} class="hover:text-[var(--color-accent)] transition-colors">Email</a>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
