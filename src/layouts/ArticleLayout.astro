---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
  tags?: string[];
  image?: string;
  readingTime?: number;
}

const { title, description, date, tags = [], image, readingTime } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout title={title} description={description} image={image}>
  <!-- Reading progress bar -->
  <div id="reading-progress" style="position:fixed;top:52px;left:0;right:0;height:3px;background:rgba(0,0,0,0.06);z-index:49;">
    <div id="reading-progress-bar" style="height:100%;width:0%;background:linear-gradient(90deg,var(--color-accent),var(--color-accent-light));transition:width 0.1s linear;"></div>
  </div>

  <div style="max-width:1200px;margin:0 auto;padding:3rem 1.5rem 5rem;">
    <div style="display:grid;grid-template-columns:1fr 260px;gap:4rem;align-items:start;" id="article-grid">

      <!-- Article content -->
      <article>
        <header style="margin-bottom:3rem;">
          {tags.length > 0 && (
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;">
              {tags.map(tag => (
                <span style="padding:0.2rem 0.75rem;background:rgba(79,124,172,0.12);color:var(--color-accent);border-radius:9999px;font-size:0.75rem;font-weight:500;">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <h1 style="font-size:2.5rem;font-weight:800;line-height:1.2;margin:0 0 1rem;letter-spacing:-0.02em;color:var(--color-text);">
            {title}
          </h1>

          {description && (
            <p style="font-size:1.125rem;color:var(--color-text-muted);line-height:1.6;margin:0 0 1.5rem;">
              {description}
            </p>
          )}

          <div style="display:flex;align-items:center;gap:1.5rem;color:var(--color-text-muted);font-size:0.875rem;padding-top:1.25rem;border-top:1px solid var(--color-border);">
            {formattedDate && (
              <span style="display:flex;align-items:center;gap:0.375rem;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {formattedDate}
              </span>
            )}
            {readingTime && (
              <span style="display:flex;align-items:center;gap:0.375rem;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {readingTime} min read
              </span>
            )}
          </div>
        </header>

        {image && (
          <div style="margin-bottom:2.5rem;border-radius:1rem;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.1);">
            <img src={image} alt={title} style="width:100%;height:auto;display:block;" />
          </div>
        )}

        <div class="prose" id="article-content">
          <slot />
        </div>
      </article>

      <!-- Sticky TOC sidebar -->
      <aside id="toc-sidebar" style="position:sticky;top:calc(52px + 2rem);max-height:calc(100vh - 52px - 4rem);overflow-y:auto;">
        <div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem;backdrop-filter:blur(8px);">
          <!-- Progress -->
          <div style="margin-bottom:1rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;">
              <span style="font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-text-muted);">Progress</span>
              <span id="toc-progress-text" style="font-size:0.75rem;font-weight:600;color:var(--color-accent);">0%</span>
            </div>
            <div style="height:4px;background:var(--color-code-bg);border-radius:9999px;overflow:hidden;">
              <div id="toc-progress-fill" style="height:100%;width:0%;background:linear-gradient(90deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;transition:width 0.15s;"></div>
            </div>
          </div>

          <p style="font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-text-muted);margin:0 0 0.75rem;">On this page</p>
          <nav id="toc-nav">
            <p style="font-size:0.8125rem;color:var(--color-text-muted);">Loading...</p>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  function buildToc() {
    const content = document.getElementById('article-content');
    const tocNav = document.getElementById('toc-nav');
    if (!content || !tocNav) return;

    const headings = Array.from(content.querySelectorAll('h2, h3, h4'));
    if (headings.length === 0) {
      tocNav.innerHTML = '<p style="font-size:0.8125rem;color:var(--color-text-muted)">No sections found.</p>';
      return;
    }

    headings.forEach((h, i) => {
      if (!h.id) {
        h.id = 'heading-' + i + '-' + h.textContent!.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      }
    });

    const ul = document.createElement('ul');
    ul.style.cssText = 'list-style:none;margin:0;padding:0;';

    headings.forEach(h => {
      const level = parseInt(h.tagName[1]);
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.dataset.headingId = h.id;
      a.textContent = h.textContent!;
      a.className = 'toc-link';
      a.style.cssText = `
        display:block;
        padding:0.3rem 0.5rem;
        font-size:${level === 2 ? '0.8125rem' : '0.75rem'};
        font-weight:${level === 2 ? '500' : '400'};
        color:var(--color-text-muted);
        text-decoration:none;
        border-radius:0.375rem;
        margin-left:${(level - 2) * 0.875}rem;
        transition:all 0.1s;
        line-height:1.4;
        border-left:2px solid transparent;
      `;
      a.addEventListener('mouseenter', () => {
        if (!a.classList.contains('toc-active')) {
          a.style.color = 'var(--color-text)';
          a.style.background = 'var(--color-code-bg)';
        }
      });
      a.addEventListener('mouseleave', () => {
        if (!a.classList.contains('toc-active')) {
          a.style.color = 'var(--color-text-muted)';
          a.style.background = '';
        }
      });
      li.appendChild(a);
      ul.appendChild(li);
    });

    tocNav.innerHTML = '';
    tocNav.appendChild(ul);
  }

  function setupProgress() {
    const progressBar = document.getElementById('reading-progress-bar');
    const tocProgressFill = document.getElementById('toc-progress-fill');
    const tocProgressText = document.getElementById('toc-progress-text');
    const content = document.getElementById('article-content');

    function update() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, Math.round((scrollTop / docHeight) * 100)) : 0;

      if (progressBar) progressBar.style.width = pct + '%';
      if (tocProgressFill) tocProgressFill.style.width = pct + '%';
      if (tocProgressText) tocProgressText.textContent = pct + '%';

      if (!content) return;
      const headings = Array.from(content.querySelectorAll('h2[id],h3[id],h4[id]'));
      let activeId = '';
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 80) activeId = h.id;
      }

      document.querySelectorAll('#toc-nav a').forEach(a => {
        const el = a as HTMLAnchorElement;
        if (el.dataset.headingId === activeId) {
          el.classList.add('toc-active');
          el.style.color = 'var(--color-accent)';
          el.style.fontWeight = '600';
          el.style.borderLeftColor = 'var(--color-accent)';
          el.style.background = 'rgba(79,124,172,0.1)';
        } else {
          el.classList.remove('toc-active');
          el.style.color = 'var(--color-text-muted)';
          el.style.fontWeight = '';
          el.style.borderLeftColor = 'transparent';
          el.style.background = '';
        }
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function handleResize() {
    const sidebar = document.getElementById('toc-sidebar');
    const grid = document.getElementById('article-grid');
    if (!sidebar || !grid) return;
    if (window.innerWidth < 900) {
      sidebar.style.display = 'none';
      grid.style.gridTemplateColumns = '1fr';
    } else {
      sidebar.style.display = 'block';
      grid.style.gridTemplateColumns = '1fr 260px';
    }
  }

  window.addEventListener('resize', handleResize);
  handleResize();
  buildToc();
  setupProgress();
</script>
