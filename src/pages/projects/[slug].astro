---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { projects as projectData } from '../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Merge with data (for tags, type info etc.)
const meta = projectData.find(p => p.slug === entry.id);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  image={entry.data.image}
>
  <!-- Back link -->
  <div style="margin-bottom:2.5rem;">
    <a href="/projects" style="display:inline-flex;align-items:center;gap:0.375rem;font-size:0.875rem;color:var(--color-text-muted);text-decoration:none;transition:color 0.15s;" class="back-link">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      All Projects
    </a>
  </div>

  <Content />

  <!-- External links from data -->
  {meta && (meta.codeLink || meta.paperLink) && (
    <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--color-border);display:flex;flex-wrap:wrap;gap:0.75rem;">
      {meta.codeLink && (
        <a href={meta.codeLink} target="_blank" rel="noopener"
          style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.625rem 1.25rem;background:var(--color-code-bg);color:var(--color-text);border:1px solid var(--color-border);border-radius:0.75rem;font-size:0.9375rem;font-weight:500;text-decoration:none;transition:all 0.15s;">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          View Code
        </a>
      )}
      {meta.paperLink && (
        <a href={meta.paperLink} target="_blank" rel="noopener"
          style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.625rem 1.25rem;background:rgba(79,124,172,0.1);color:var(--color-accent);border:1px solid var(--color-accent);border-radius:0.75rem;font-size:0.9375rem;font-weight:500;text-decoration:none;transition:all 0.15s;">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Read Paper
        </a>
      )}
    </div>
  )}
</ArticleLayout>

<style>
  .back-link:hover { color: var(--color-accent) !important; }
</style>
