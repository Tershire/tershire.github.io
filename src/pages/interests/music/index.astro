---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArtistsCarousel from '../../../components/ArtistsCarousel';
import MusicReviewsGrid from '../../../components/MusicReviewsGrid';
import { getCollection } from 'astro:content';
import { favoriteArtists } from '../../../data/music';

const entries = await getCollection('music');

function youtubeVideoId(url: string): string | null {
  try {
    const u = new URL(url);
    return u.searchParams.get('v') ?? (u.hostname === 'youtu.be' ? u.pathname.slice(1).split('?')[0] : null);
  } catch { return null; }
}

function extractYouTubeIdFromBody(body: string): string | null {
  const urlMatch = body.match(/<YouTubePlaylist[^>]+url="([^"]+)"|<YouTube[^>]+url="([^"]+)"/);
  if (urlMatch) return youtubeVideoId(urlMatch[1] ?? urlMatch[2]);
  const idMatch = body.match(/<YouTube[^>]+id="([^"]+)"/);
  if (idMatch) return idMatch[1];
  return null;
}

function extractSpotifyUrlFromBody(body: string): string | null {
  const match = body.match(/<SpotifyEmbed[^>]+url="([^"]+)"/);
  return match ? match[1] : null;
}

function extractAppleMusicUrlFromBody(body: string): string | null {
  const match = body.match(/<AppleMusicEmbed[^>]+url="([^"]+)"/);
  return match ? match[1] : null;
}

async function resolveImage(data: typeof entries[0]['data'], body: string): Promise<string | undefined> {
  if (data.image) return data.image;
  if (data.spotifyUrl) {
    try {
      const res = await fetch(`https://open.spotify.com/oembed?url=${encodeURIComponent(data.spotifyUrl)}`);
      if (res.ok) {
        const oembed = await res.json() as { thumbnail_url?: string };
        if (oembed.thumbnail_url) return oembed.thumbnail_url;
      }
    } catch {}
  }
  if (data.appleMusicUrl) {
    try {
      const res = await fetch(`https://music.apple.com/oembed?url=${encodeURIComponent(data.appleMusicUrl)}`);
      if (res.ok) {
        const oembed = await res.json() as { thumbnail_url?: string };
        if (oembed.thumbnail_url) return oembed.thumbnail_url;
      }
    } catch {}
  }
  if (data.youtubeUrl) {
    const vid = youtubeVideoId(data.youtubeUrl);
    if (vid) return `https://img.youtube.com/vi/${vid}/maxresdefault.jpg`;
  }
  // Auto-detect embed components from article body
  const spotifyUrl = extractSpotifyUrlFromBody(body);
  if (spotifyUrl) {
    try {
      const res = await fetch(`https://open.spotify.com/oembed?url=${encodeURIComponent(spotifyUrl)}`);
      if (res.ok) {
        const oembed = await res.json() as { thumbnail_url?: string };
        if (oembed.thumbnail_url) return oembed.thumbnail_url;
      }
    } catch {}
  }
  const appleMusicUrl = extractAppleMusicUrlFromBody(body);
  if (appleMusicUrl) {
    try {
      const res = await fetch(`https://music.apple.com/oembed?url=${encodeURIComponent(appleMusicUrl)}`);
      if (res.ok) {
        const oembed = await res.json() as { thumbnail_url?: string };
        if (oembed.thumbnail_url) return oembed.thumbnail_url;
      }
    } catch {}
  }
  const vid = extractYouTubeIdFromBody(body);
  if (vid) return `https://img.youtube.com/vi/${vid}/maxresdefault.jpg`;
  return undefined;
}

const reviews = (await Promise.all(
  entries.map(async e => ({
    slug: e.id,
    ...e.data,
    image: await resolveImage(e.data, e.body ?? ''),
  }))
)).sort((a, b) => new Date(b.releaseDate).valueOf() - new Date(a.releaseDate).valueOf());
---

<BaseLayout title="Music" description="Artists I love and albums worth writing about.">
  <div class="page-container py-16">

    <!-- Page header -->
    <div style="margin-bottom:3rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <div style="width:3px;height:2rem;background:linear-gradient(180deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;"></div>
        <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);margin:0;">Interests</p>
      </div>
      <h1 class="section-title">Music</h1>
      <p class="section-subtitle" style="max-width:42rem;">
        Artists I keep coming back to, and occasional thoughts on records worth sitting with.
      </p>
    </div>

    <!-- Favorites section -->
    <div style="margin-bottom:3.5rem;">
      <h2 style="font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0 0 1.25rem;display:flex;align-items:center;gap:0.625rem;">
        <span>Favorites</span>
        <span style="font-size:0.75rem;font-weight:500;color:var(--color-text-muted);padding:0.15rem 0.625rem;background:var(--color-code-bg);border-radius:9999px;">
          {favoriteArtists.length} artists
        </span>
      </h2>
      <ArtistsCarousel artists={favoriteArtists} client:load />
    </div>

    <!-- Reviews section -->
    <div>
      <h2 style="font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0 0 1.5rem;display:flex;align-items:center;gap:0.625rem;">
        <span>Reviews</span>
        <span style="font-size:0.75rem;font-weight:500;color:var(--color-text-muted);padding:0.15rem 0.625rem;background:var(--color-code-bg);border-radius:9999px;">
          {reviews.length} entries
        </span>
      </h2>
      <MusicReviewsGrid reviews={reviews} client:load />
    </div>

  </div>
</BaseLayout>
