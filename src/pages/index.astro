---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, NAV_LINKS } from '../data/site';
---

<BaseLayout noNav noPadding title="Home">
  <!-- Top nav bar -->
  <header class="fixed top-0 left-0 right-0 z-50 h-[52px] bg-black/40 backdrop-blur-md border-b border-white/10">
    <div style="max-width:1400px;margin:0 auto;padding:0 1.5rem;height:100%;display:flex;align-items:center;justify-content:space-between;">
      <span style="color:white;font-weight:600;font-size:1.125rem;letter-spacing:0.025em;">{SITE.name}</span>
      <nav>
        <ul style="display:flex;align-items:center;gap:0.25rem;list-style:none;margin:0;padding:0;">
          {NAV_LINKS.map((link) => (
            <li style="position:relative;" class="nav-item">
              <a
                href={link.href}
                style="padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;color:rgba(255,255,255,0.8);text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem;transition:all 0.15s;"
                class="nav-link"
              >
                {link.label}
                {link.children.length > 0 && (
                  <svg style="width:12px;height:12px;opacity:0.6;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
              {link.children.length > 0 && (
                <div class="nav-dropdown" style="position:absolute;top:100%;left:0;padding-top:0.5rem;opacity:0;visibility:hidden;transition:all 0.15s;pointer-events:none;">
                  <ul style="background:rgba(255,255,255,0.97);backdrop-filter:blur(8px);border:1px solid #e5e7eb;border-radius:0.75rem;box-shadow:0 10px 25px rgba(0,0,0,0.12);padding:0.25rem;min-width:160px;list-style:none;margin:0;">
                    {link.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          style="display:block;padding:0.625rem 1rem;font-size:0.875rem;color:#374151;text-decoration:none;border-radius:0.5rem;transition:all 0.1s;"
                          class="dropdown-link"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <!-- Full-screen background -->
  <div style="position:fixed;inset:0;z-index:-10;">
    <img
      id="home-bg"
      src={SITE.homeBg}
      alt=""
      style="width:100%;height:100%;object-fit:cover;"
    />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#1e293b,#334155,#475569);"></div>
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.25);"></div>
  </div>

  <!-- Left side panel -->
  <aside style="position:fixed;left:0;top:0;bottom:0;z-index:40;width:17rem;background:rgba(0,0,0,0.55);backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,0.1);display:flex;flex-direction:column;">
    <!-- Profile -->
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3rem 2rem;text-align:center;">
      <!-- Avatar -->
      <div style="position:relative;margin-bottom:1.5rem;">
        <div id="avatar-wrap" style="width:7rem;height:7rem;border-radius:50%;overflow:hidden;border:2px solid rgba(255,255,255,0.25);box-shadow:0 8px 32px rgba(0,0,0,0.3);">
          <img
            src={SITE.profileImage}
            alt={SITE.author}
            style="width:100%;height:100%;object-fit:cover;"
            id="profile-img"
          />
        </div>
        <div style="position:absolute;bottom:-2px;right:-2px;width:18px;height:18px;background:#4ade80;border-radius:50%;border:2px solid rgba(0,0,0,0.5);"></div>
      </div>

      <h1 style="color:white;font-size:1.375rem;font-weight:700;margin:0 0 0.25rem;letter-spacing:0.025em;">{SITE.author}</h1>
      <p style="color:rgba(255,255,255,0.55);font-size:0.8125rem;margin:0 0 1.5rem;line-height:1.6;">{SITE.tagline}</p>

      <div style="width:2.5rem;height:1px;background:rgba(255,255,255,0.2);margin-bottom:1.5rem;"></div>

      <p style="color:rgba(255,255,255,0.45);font-size:0.75rem;line-height:1.7;margin:0 0 2rem;">
        Exploring the intersection of robotics, perception, and intelligent systems.
        Passionate about turning ideas into working prototypes.
      </p>

      <!-- Social links -->
      <div style="display:flex;gap:0.75rem;">
        <a href={SITE.github} target="_blank" rel="noopener"
          style="width:2.25rem;height:2.25rem;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.65);text-decoration:none;transition:all 0.15s;"
          class="social-icon"
          aria-label="GitHub">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a href={`mailto:${SITE.email}`}
          style="width:2.25rem;height:2.25rem;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.65);text-decoration:none;transition:all 0.15s;"
          class="social-icon"
          aria-label="Email">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick nav -->
    <nav style="padding:0 1rem 2rem;">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          style="display:flex;align-items:center;gap:0.75rem;padding:0.625rem 1rem;border-radius:0.75rem;color:rgba(255,255,255,0.55);text-decoration:none;font-size:0.875rem;font-weight:500;transition:all 0.15s;margin-bottom:0.25rem;"
          class="side-nav-link"
        >
          <span style="width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.25);flex-shrink:0;transition:background 0.15s;" class="side-dot"></span>
          {link.label}
        </a>
      ))}
    </nav>
  </aside>

  <!-- Main content -->
  <div style="margin-left:17rem;height:100vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:0 5rem;color:white;">
    <div style="max-width:32rem;">
      <p style="color:rgba(255,255,255,0.45);font-size:0.75rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;margin:0 0 1rem;">Welcome</p>
      <h2 style="font-size:3.5rem;font-weight:800;line-height:1.1;margin:0 0 1.5rem;letter-spacing:-0.02em;">
        Research.<br />Build.<br />Explore.
      </h2>
      <p style="color:rgba(255,255,255,0.65);font-size:1.0625rem;line-height:1.75;margin:0 0 2.5rem;">
        This is my corner of the internet — where I document research, share projects,
        and talk about the things I love outside the lab.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;">
        <a href="/projects"
          style="padding:0.75rem 1.75rem;background:white;color:#111827;border-radius:0.75rem;font-weight:600;font-size:0.9375rem;text-decoration:none;box-shadow:0 4px 16px rgba(0,0,0,0.2);transition:all 0.15s;">
          See Projects
        </a>
        <a href="/about"
          style="padding:0.75rem 1.75rem;background:rgba(255,255,255,0.12);color:white;border-radius:0.75rem;font-weight:600;font-size:0.9375rem;text-decoration:none;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.2);transition:all 0.15s;">
          About Me
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Nav hover effects
  document.querySelectorAll('.nav-item').forEach(item => {
    const dropdown = item.querySelector('.nav-dropdown') as HTMLElement;
    if (!dropdown) return;
    item.addEventListener('mouseenter', () => {
      dropdown.style.opacity = '1';
      dropdown.style.visibility = 'visible';
      dropdown.style.pointerEvents = 'auto';
    });
    item.addEventListener('mouseleave', () => {
      dropdown.style.opacity = '0';
      dropdown.style.visibility = 'hidden';
      dropdown.style.pointerEvents = 'none';
    });
  });

  document.querySelectorAll('.nav-link').forEach(a => {
    a.addEventListener('mouseenter', () => { (a as HTMLElement).style.background = 'rgba(255,255,255,0.1)'; (a as HTMLElement).style.color = 'white'; });
    a.addEventListener('mouseleave', () => { (a as HTMLElement).style.background = ''; (a as HTMLElement).style.color = 'rgba(255,255,255,0.8)'; });
  });

  document.querySelectorAll('.dropdown-link').forEach(a => {
    a.addEventListener('mouseenter', () => { (a as HTMLElement).style.background = '#f9fafb'; (a as HTMLElement).style.color = '#4f7cac'; });
    a.addEventListener('mouseleave', () => { (a as HTMLElement).style.background = ''; (a as HTMLElement).style.color = '#374151'; });
  });

  document.querySelectorAll('.social-icon').forEach(a => {
    a.addEventListener('mouseenter', () => { (a as HTMLElement).style.background = 'rgba(255,255,255,0.2)'; (a as HTMLElement).style.color = 'white'; });
    a.addEventListener('mouseleave', () => { (a as HTMLElement).style.background = 'rgba(255,255,255,0.1)'; (a as HTMLElement).style.color = 'rgba(255,255,255,0.65)'; });
  });

  document.querySelectorAll('.side-nav-link').forEach(a => {
    a.addEventListener('mouseenter', () => {
      (a as HTMLElement).style.background = 'rgba(255,255,255,0.08)';
      (a as HTMLElement).style.color = 'white';
      const dot = a.querySelector('.side-dot') as HTMLElement;
      if (dot) dot.style.background = '#7aa3cc';
    });
    a.addEventListener('mouseleave', () => {
      (a as HTMLElement).style.background = '';
      (a as HTMLElement).style.color = 'rgba(255,255,255,0.55)';
      const dot = a.querySelector('.side-dot') as HTMLElement;
      if (dot) dot.style.background = 'rgba(255,255,255,0.25)';
    });
  });

  // Handle missing profile image
  const profileImg = document.getElementById('profile-img') as HTMLImageElement;
  if (profileImg) {
    profileImg.onerror = () => {
      const wrap = document.getElementById('avatar-wrap');
      if (wrap) {
        wrap.innerHTML = '<div style="width:100%;height:100%;background:linear-gradient(135deg,#64748b,#475569);display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;font-weight:700;">T</div>';
      }
    };
  }

  // Handle missing background image
  const bgImg = document.getElementById('home-bg') as HTMLImageElement;
  if (bgImg) {
    bgImg.onerror = () => { bgImg.style.display = 'none'; };
  }
</script>
