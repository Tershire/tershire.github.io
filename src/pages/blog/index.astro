---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogGrid from '../../components/BlogGrid';
import type { BlogPost } from '../../components/BlogGrid';

const entries = await getCollection('blog');
const posts: BlogPost[] = entries
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .map(entry => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    tags: entry.data.tags ?? [],
    image: entry.data.image,
  }));
---

<BaseLayout title="Blog" description="Writing on robotics, research, and life outside the lab.">
  <div class="page-container py-16">
    <div style="margin-bottom:3rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <div style="width:3px;height:2rem;background:linear-gradient(180deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;"></div>
        <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);margin:0;">Writing</p>
      </div>
      <h1 class="section-title">Blog</h1>
      <p class="section-subtitle">
        Notes on robotics, research, and the occasional non-technical thing I find interesting.
      </p>
    </div>

    <BlogGrid posts={posts} client:load />
  </div>
</BaseLayout>
