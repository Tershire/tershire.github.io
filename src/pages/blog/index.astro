---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const TAG_COLORS: Record<string, string> = {
  SLAM: '#dbeafe:#1d4ed8',
  Robotics: '#d1fae5:#065f46',
  Tutorial: '#fef3c7:#92400e',
  Photography: '#fce7f3:#be185d',
  Film: '#fef3c7:#d97706',
  Hobby: '#f3e8ff:#7c3aed',
};

function tagStyle(tag: string) {
  const pair = TAG_COLORS[tag] ?? '#f3f4f6:#374151';
  const [bg, text] = pair.split(':');
  return `background:${bg};color:${text};`;
}
---

<BaseLayout title="Blog" description="Writing on robotics, research, and life outside the lab.">
  <div class="page-container py-16">
    <div style="margin-bottom:3rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <div style="width:3px;height:2rem;background:linear-gradient(180deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;"></div>
        <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);margin:0;">Writing</p>
      </div>
      <h1 class="section-title">Blog</h1>
      <p class="section-subtitle">
        Notes on robotics, research, and the occasional non-technical thing I find interesting.
      </p>
    </div>

    <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:680px;">
      {posts.map(post => {
        const date = new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        return (
          <a
            href={`/blog/${post.id}`}
            style="display:block;text-decoration:none;background:var(--color-card);border:1px solid var(--color-border);border-radius:1rem;padding:1.75rem;transition:all 0.2s;"
            class="blog-card"
          >
            {post.data.tags && (
              <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.875rem;">
                {post.data.tags.map((tag: string) => (
                  <span style={`padding:0.15rem 0.625rem;border-radius:9999px;font-size:0.6875rem;font-weight:500;${tagStyle(tag)}`}>
                    {tag}
                  </span>
                ))}
              </div>
            )}
            <h2 style="margin:0 0 0.625rem;font-size:1.1875rem;font-weight:700;color:var(--color-text);line-height:1.35;">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p style="margin:0 0 1rem;font-size:0.9375rem;color:var(--color-text-muted);line-height:1.6;">
                {post.data.description}
              </p>
            )}
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <span style="font-size:0.8125rem;color:var(--color-text-muted);">{date}</span>
              <svg style="color:var(--color-text-muted);" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }
</style>
