---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const timeline = [
  { year: '2025–Now', title: 'Navigation Engineer', org: 'Hanwha Aerospace', desc: 'INS-GNSS, SLAM.' },
  { year: '2023–2024', title: 'M.S. in Aerospace Systems & Control', org: 'ISAE-SUPAERO', desc: 'Thesis: ....' },
  { year: '2016–2022', title: 'B.S. in Aerospace Engineering', org: 'Georgia Institute of Technology', desc: '.' },
];

const skills = {
  'Navigation': ['SLAM', 'VO', 'INS-GNSS'],
  'Machine Learning': ['PyTorch'],
  'Systems': ['ROS2', 'C++17', 'Python', 'Embedded (STM32)'],
  'Tools': ['Git', 'Docker', 'SolidWorks'],
};
---

<BaseLayout title="About" description="About Tershire — researcher, engineer, human.">
  <div class="page-container py-16">
    <div style="display:grid;grid-template-columns:1fr 300px;gap:5rem;align-items:start;" id="about-grid">

      <!-- Left: bio + timeline -->
      <div>
        <div style="margin-bottom:3rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
            <div style="width:3px;height:2rem;background:linear-gradient(180deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;"></div>
            <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);margin:0;">Who I Am</p>
          </div>
          <h1 class="section-title">About Me</h1>
        </div>

        <!-- Bio -->
        <div class="prose" style="margin-bottom:3rem;">
          <p>
            I am an navigation engineer and have a deep interest in SLAM. 
          </p>
          <p>
            - favorite sensors: mono camera, IMU
          </p>
          <p>
            - research interests: online learning, efficient SLAM data representation (just like a human), dynamic environments, scene-graphs, biomimetics
          <p>
            I'm from Seoul.
          </p>
          <p>
            Feel free to reach out.
          </p>
        </div>

        <!-- Timeline -->
        <div>
          <h2 style="font-size:1.375rem;font-weight:700;margin:0 0 1.75rem;color:var(--color-text);">Timeline</h2>
          <div style="position:relative;padding-left:2rem;">
            <!-- Vertical line -->
            <div style="position:absolute;left:0;top:0.5rem;bottom:0;width:2px;background:linear-gradient(180deg,var(--color-accent),var(--color-border));border-radius:9999px;"></div>

            {timeline.map((item, i) => (
              <div style={`position:relative;margin-bottom:${i < timeline.length - 1 ? '2.25rem' : '0'};`}>
                <!-- Dot -->
                <div style="position:absolute;left:-2.375rem;top:0.25rem;width:12px;height:12px;border-radius:50%;background:var(--color-accent);border:2px solid var(--color-card);box-shadow:0 0 0 2px var(--color-accent);"></div>

                <span style="font-size:0.8125rem;font-weight:600;color:var(--color-accent);">{item.year}</span>
                <h3 style="margin:0.25rem 0 0.125rem;font-size:1.0625rem;font-weight:600;color:var(--color-text);">{item.title}</h3>
                <p style="margin:0 0 0.5rem;font-size:0.9375rem;color:var(--color-text-muted);font-weight:500;">{item.org}</p>
                <p style="margin:0;font-size:0.9375rem;color:var(--color-text);line-height:1.6;">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: profile card + skills -->
      <div style="position:sticky;top:calc(52px + 2rem);">
        <!-- Profile card -->
        <div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:1.25rem;padding:2rem;text-align:center;margin-bottom:1.5rem;">
          <div style="width:6rem;height:6rem;border-radius:50%;overflow:hidden;margin:0 auto 1.25rem;border:2px solid var(--color-border);">
            <img
              src={SITE.profileImage}
              alt={SITE.author}
              style="width:100%;height:100%;object-fit:cover;"
              onerror="this.parentElement.innerHTML='<div style=\'width:100%;height:100%;background:linear-gradient(135deg,#64748b,#475569);display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;font-weight:700;\'>T</div>'"
            />
          </div>
          <h2 style="margin:0 0 0.25rem;font-size:1.25rem;font-weight:700;color:var(--color-text);">{SITE.author}</h2>
          <p style="margin:0 0 1.25rem;font-size:0.875rem;color:var(--color-text-muted);">{SITE.tagline}</p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <a href={`mailto:${SITE.email}`} style="display:flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.625rem;background:var(--color-code-bg);border:1px solid var(--color-border);border-radius:0.75rem;font-size:0.875rem;color:var(--color-text);text-decoration:none;transition:all 0.15s;" class="contact-btn">
              <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {SITE.email}
            </a>
            <a href={SITE.github} target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.625rem;background:var(--color-code-bg);border:1px solid var(--color-border);border-radius:0.75rem;font-size:0.875rem;color:var(--color-text);text-decoration:none;transition:all 0.15s;" class="contact-btn">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>

        <!-- Skills -->
        <div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:1.25rem;padding:1.5rem;">
          <h3 style="font-size:0.9375rem;font-weight:700;margin:0 0 1.25rem;color:var(--color-text);">Skills & Tools</h3>
          {Object.entries(skills).map(([category, items]) => (
            <div style="margin-bottom:1.25rem;">
              <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-muted);margin:0 0 0.625rem;">{category}</p>
              <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
                {items.map(skill => (
                  <span style="padding:0.2rem 0.625rem;background:var(--color-code-bg);color:var(--color-text);border-radius:9999px;font-size:0.75rem;font-weight:500;">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .contact-btn:hover { background: var(--color-border) !important; }
  @media (max-width: 768px) {
    #about-grid { grid-template-columns: 1fr !important; }
  }
</style>
