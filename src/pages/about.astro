---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const timeline = [
  { year: '2023–Now', title: 'Ph.D. Candidate', org: 'KAIST, Robotics Program', desc: 'Dissertation on robust state estimation for legged robots in unstructured environments.' },
  { year: '2021–2023', title: 'Research Engineer', org: 'Naver Labs', desc: 'Built the perception stack for the indoor delivery robot fleet — mapping, localization, obstacle detection.' },
  { year: '2019–2021', title: 'M.S. in Robotics', org: 'Seoul National University', desc: 'Thesis on depth completion from sparse LiDAR and monocular cameras.' },
  { year: '2015–2019', title: 'B.S. in Mechanical Engineering', org: 'POSTECH', desc: 'Graduated with honors. Minored in computer science. Captain of the university robot team.' },
];

const skills = {
  'Robotics & Perception': ['SLAM', 'VIO', 'Point Cloud Processing', 'Object Detection', 'Depth Estimation'],
  'ML & Deep Learning': ['PyTorch', 'NeRF / Neural Fields', 'Self-Supervised Learning', 'Reinforcement Learning'],
  'Systems': ['ROS2', 'C++17', 'Python', 'CUDA', 'micro-ROS', 'Embedded (STM32)'],
  'Tools': ['Git', 'Docker', 'KiCAD', 'SolidWorks', 'Blender'],
};
---

<BaseLayout title="About" description="About Tershire — researcher, engineer, human.">
  <div class="page-container py-16">
    <div style="display:grid;grid-template-columns:1fr 300px;gap:5rem;align-items:start;" id="about-grid">

      <!-- Left: bio + timeline -->
      <div>
        <div style="margin-bottom:3rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
            <div style="width:3px;height:2rem;background:linear-gradient(180deg,#4f7cac,#7aa3cc);border-radius:9999px;"></div>
            <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:#9ca3af;margin:0;">Who I Am</p>
          </div>
          <h1 class="section-title">About Me</h1>
        </div>

        <!-- Bio -->
        <div class="prose" style="margin-bottom:3rem;">
          <p>
            I'm a Ph.D. candidate at KAIST working on robust state estimation and perception for legged robots.
            My research sits at the intersection of computer vision, IMU-based sensing, and learning-based methods —
            I want robots to be able to navigate the real world reliably, even when things go wrong.
          </p>
          <p>
            Before KAIST, I spent two years at Naver Labs building the perception stack for indoor delivery robots.
            That experience gave me a healthy respect for the gap between research demos and production systems.
          </p>
          <p>
            I'm from Seoul. Outside of research, I shoot film photography, climb rocks, and have too many mechanical keyboards.
            I try to write regularly — both technical posts and occasional personal reflections.
          </p>
          <p>
            If you want to collaborate, ask about my research, or just talk about cameras, feel free to reach out.
          </p>
        </div>

        <!-- Timeline -->
        <div>
          <h2 style="font-size:1.375rem;font-weight:700;margin:0 0 1.75rem;color:#111827;">Timeline</h2>
          <div style="position:relative;padding-left:2rem;">
            <!-- Vertical line -->
            <div style="position:absolute;left:0;top:0.5rem;bottom:0;width:2px;background:linear-gradient(180deg,#4f7cac,#e5e5e0);border-radius:9999px;"></div>

            {timeline.map((item, i) => (
              <div style={`position:relative;margin-bottom:${i < timeline.length - 1 ? '2.25rem' : '0'};`}>
                <!-- Dot -->
                <div style="position:absolute;left:-2.375rem;top:0.25rem;width:12px;height:12px;border-radius:50%;background:#4f7cac;border:2px solid white;box-shadow:0 0 0 2px #4f7cac;"></div>

                <span style="font-size:0.8125rem;font-weight:600;color:#4f7cac;">{item.year}</span>
                <h3 style="margin:0.25rem 0 0.125rem;font-size:1.0625rem;font-weight:600;color:#111827;">{item.title}</h3>
                <p style="margin:0 0 0.5rem;font-size:0.9375rem;color:#6b7280;font-weight:500;">{item.org}</p>
                <p style="margin:0;font-size:0.9375rem;color:#374151;line-height:1.6;">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: profile card + skills -->
      <div style="position:sticky;top:calc(52px + 2rem);">
        <!-- Profile card -->
        <div style="background:white;border:1px solid #e5e5e0;border-radius:1.25rem;padding:2rem;text-align:center;margin-bottom:1.5rem;">
          <div style="width:6rem;height:6rem;border-radius:50%;overflow:hidden;margin:0 auto 1.25rem;border:2px solid #e5e5e0;">
            <img
              src={SITE.profileImage}
              alt={SITE.author}
              style="width:100%;height:100%;object-fit:cover;"
              onerror="this.parentElement.innerHTML='<div style=\'width:100%;height:100%;background:linear-gradient(135deg,#64748b,#475569);display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;font-weight:700;\'>T</div>'"
            />
          </div>
          <h2 style="margin:0 0 0.25rem;font-size:1.25rem;font-weight:700;">{SITE.author}</h2>
          <p style="margin:0 0 1.25rem;font-size:0.875rem;color:#6b7280;">{SITE.tagline}</p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <a href={`mailto:${SITE.email}`} style="display:flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.625rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:0.75rem;font-size:0.875rem;color:#374151;text-decoration:none;transition:all 0.15s;" class="contact-btn">
              <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {SITE.email}
            </a>
            <a href={SITE.github} target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.625rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:0.75rem;font-size:0.875rem;color:#374151;text-decoration:none;transition:all 0.15s;" class="contact-btn">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>

        <!-- Skills -->
        <div style="background:white;border:1px solid #e5e5e0;border-radius:1.25rem;padding:1.5rem;">
          <h3 style="font-size:0.9375rem;font-weight:700;margin:0 0 1.25rem;color:#111827;">Skills & Tools</h3>
          {Object.entries(skills).map(([category, items]) => (
            <div style="margin-bottom:1.25rem;">
              <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:#9ca3af;margin:0 0 0.625rem;">{category}</p>
              <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
                {items.map(skill => (
                  <span style="padding:0.2rem 0.625rem;background:#f3f4f6;color:#374151;border-radius:9999px;font-size:0.75rem;font-weight:500;">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .contact-btn:hover { background: #f3f4f6 !important; }
  @media (max-width: 768px) {
    #about-grid { grid-template-columns: 1fr !important; }
  }
</style>
