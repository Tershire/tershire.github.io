---
import BaseLayout from '../../layouts/BaseLayout.astro';

const hobbies = [
  {
    name: 'Film Photography',
    emoji: '📷',
    color: '#fef3c7',
    accent: '#d97706',
    description:
      'There\'s something irreplaceable about the deliberateness of shooting on film. I shoot mostly 35mm — Kodak Portra for color, Ilford HP5 for black and white. The wait for developed rolls is part of the joy.',
    highlights: ['Pentax K1000', 'Kodak Portra 400', 'Street & landscape', 'Self-developing B&W'],
    image: '/images/hobbies/film-photography.jpg',
  },
  {
    name: 'Rock Climbing',
    emoji: '🧗',
    color: '#d1fae5',
    accent: '#059669',
    description:
      'Bouldering indoors keeps me sharp during the week; sport climbing outdoors is where I actually feel alive. Currently projecting V7 in the gym and working on leading 5.11c outside.',
    highlights: ['Bouldering V6–V7', 'Sport climbing 5.11', 'La Sportiva Solutions', 'Outdoor adventures'],
    image: '/images/hobbies/climbing.jpg',
  },
  {
    name: 'Mechanical Keyboards',
    emoji: '⌨️',
    color: '#dbeafe',
    accent: '#2563eb',
    description:
      'The hobby that started as "I just need a better keyboard for coding" and spiraled. I hand-wire custom builds, lubricate my own switches, and have opinions about stabilizers that I inflict on anyone who will listen.',
    highlights: ['Hand-wired builds', 'Tactile & linear switches', 'KiCAD PCB design', 'Foam dampening mods'],
    image: '/images/hobbies/keyboard.jpg',
  },
  {
    name: 'Espresso',
    emoji: '☕',
    color: '#fce7f3',
    accent: '#be185d',
    description:
      'Single-origin pour-overs on weekdays, weekend espresso ritual with a gaggia classic pro. I track extraction data obsessively and have strong opinions about water mineral content.',
    highlights: ['Gaggia Classic Pro', 'Single-origin beans', 'Water chemistry', 'Light roast espresso'],
    image: '/images/hobbies/espresso.jpg',
  },
  {
    name: 'Reading',
    emoji: '📚',
    color: '#f3e8ff',
    accent: '#7c3aed',
    description:
      'History of science, philosophy of mind, and good fiction. Currently reading Gödel, Escher, Bach for the third time. Always have a physical book and an audiobook going simultaneously.',
    highlights: ['History of science', 'Philosophy of mind', 'Douglas Hofstadter', 'Classic sci-fi'],
  },
  {
    name: 'Cycling',
    emoji: '🚴',
    color: '#ecfdf5',
    accent: '#10b981',
    description:
      'Weekend rides along the Han River and occasional longer gravel routes outside the city. The bike is a 2021 Canyon Grail — aluminum, sensible. I\'m not a roadie, I just like going places.',
    highlights: ['Canyon Grail', 'Gravel routes', 'Han River rides', '60–80 km weekends'],
  },
];
---

<BaseLayout title="Hobbies" description="What Tershire does outside the lab.">
  <div class="page-container py-16">
    <!-- Header -->
    <div style="margin-bottom:4rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <div style="width:3px;height:2rem;background:linear-gradient(180deg,#4f7cac,#7aa3cc);border-radius:9999px;"></div>
        <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:#9ca3af;margin:0;">Beyond the Lab</p>
      </div>
      <h1 class="section-title">Hobbies & Interests</h1>
      <p class="section-subtitle" style="max-width:42rem;">
        Outside of research, I spend my time on things that keep me curious, grounded, and occasionally caffeinated.
        These are the things that make the work feel sustainable.
      </p>
    </div>

    <!-- Hobbies grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1.5rem;">
      {hobbies.map((hobby) => (
        <div
          class="hobby-card"
          style={`background:white;border:1px solid #e5e5e0;border-radius:1.25rem;overflow:hidden;transition:all 0.2s;`}
        >
          {/* Image or color header */}
          {hobby.image ? (
            <div style="height:180px;overflow:hidden;background:#f3f4f6;">
              <img
                src={hobby.image}
                alt={hobby.name}
                style="width:100%;height:100%;object-fit:cover;transition:transform 0.3s;"
                class="hobby-img"
                onerror={`this.parentElement.innerHTML='<div style="height:100%;display:flex;align-items:center;justify-content:center;background:${hobby.color};font-size:3.5rem;">${hobby.emoji}</div>'`}
              />
            </div>
          ) : (
            <div style={`height:100px;background:${hobby.color};display:flex;align-items:center;justify-content:center;font-size:3.5rem;`}>
              {hobby.emoji}
            </div>
          )}

          {/* Content */}
          <div style="padding:1.5rem;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
              {!hobby.image && <span style="font-size:1.375rem;">{hobby.emoji}</span>}
              <h2 style={`font-size:1.1875rem;font-weight:700;margin:0;color:${hobby.accent};`}>{hobby.name}</h2>
            </div>

            <p style="font-size:0.9375rem;color:#374151;line-height:1.7;margin:0 0 1.25rem;">{hobby.description}</p>

            {/* Highlights */}
            <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
              {hobby.highlights.map(h => (
                <span style={`padding:0.2rem 0.75rem;background:${hobby.color};color:${hobby.accent};border-radius:9999px;font-size:0.75rem;font-weight:500;`}>
                  {h}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hobby-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    transform: translateY(-3px);
  }
  .hobby-card:hover .hobby-img {
    transform: scale(1.04);
  }
</style>
