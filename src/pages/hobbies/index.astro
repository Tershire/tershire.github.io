---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HobbiesGrid from '../../components/HobbiesGrid';
import { hobbies } from '../../data/hobbies';
---

<BaseLayout title="Hobbies" description="What Tershire does outside the lab.">
  <div class="page-container py-16">
    <div style="margin-bottom:3rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <div style="width:3px;height:2rem;background:linear-gradient(180deg,var(--color-accent),var(--color-accent-light));border-radius:9999px;"></div>
        <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);margin:0;">Beyond the Lab</p>
      </div>
      <h1 class="section-title">Hobbies & Interests</h1>
      <p class="section-subtitle" style="max-width:42rem;">
        Outside of research, I spend time on things that keep me curious, grounded, and occasionally caffeinated.
      </p>
    </div>

    <HobbiesGrid hobbies={hobbies} client:load />
  </div>
</BaseLayout>
