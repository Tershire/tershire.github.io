---
interface Props {
  id?: string;
  url?: string;
  start?: number;
  title?: string;
}

const { id, url, start, title = 'YouTube video' } = Astro.props;

function parseTime(t: string): number {
  // Formats: "90", "1m30s", "1h2m3s", "30s", "1m"
  if (/^\d+$/.test(t)) return parseInt(t);
  let seconds = 0;
  const h = t.match(/(\d+)h/); if (h) seconds += parseInt(h[1]) * 3600;
  const m = t.match(/(\d+)m/); if (m) seconds += parseInt(m[1]) * 60;
  const s = t.match(/(\d+)s/); if (s) seconds += parseInt(s[1]);
  return seconds;
}

function parseYouTube(rawUrl: string): { videoId: string | null; listId: string | null; startSec: number | null } {
  try {
    const u = new URL(rawUrl);
    const videoId = u.searchParams.get('v') ?? (u.hostname === 'youtu.be' ? u.pathname.slice(1).split('?')[0] : null);
    const listId = u.searchParams.get('list');
    const t = u.searchParams.get('t');
    const startSec = t ? parseTime(t) : null;
    return { videoId, listId, startSec };
  } catch {
    return { videoId: null, listId: null, startSec: null };
  }
}

let videoId: string | null = id ?? null;
let listId: string | null = null;
let startSec: number | null = start ?? null;

if (url) {
  const parsed = parseYouTube(url);
  videoId = parsed.videoId;
  listId = parsed.listId;
  if (parsed.startSec !== null) startSec = parsed.startSec;
}

// Build embed URL
let embedUrl = '';
const params = new URLSearchParams();
if (listId) params.set('list', listId);
if (startSec) params.set('start', String(startSec));
const qs = params.toString() ? `?${params.toString()}` : '';

if (videoId) {
  embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}${qs}`;
} else if (listId) {
  embedUrl = `https://www.youtube-nocookie.com/embed/?listType=playlist&list=${listId}`;
}
---

{embedUrl && (
  <div style="position:relative;width:100%;padding-bottom:56.25%;border-radius:0.75rem;overflow:hidden;margin:2rem 0;">
    <iframe
      src={embedUrl}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
      style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
    ></iframe>
  </div>
)}
