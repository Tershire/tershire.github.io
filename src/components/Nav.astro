---
import { NAV_LINKS, SITE } from '../data/site';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<nav
  id="top-nav"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 h-[52px] transition-all duration-300',
    transparent
      ? 'bg-black/40 backdrop-blur-md border-b border-white/10'
      : 'bg-black/80 backdrop-blur-md border-b border-white/10',
  ]}
>
  <div class="page-container h-full flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-white font-semibold text-lg tracking-wide hover:opacity-80 transition-opacity">
      {SITE.name}
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-1">
      {NAV_LINKS.map((link) => (
        <li class="relative group">
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-md text-sm font-medium transition-colors inline-flex items-center gap-1',
              pathname.startsWith(link.href) && link.href !== '/'
                ? 'text-white bg-white/15'
                : 'text-white/80 hover:text-white hover:bg-white/10',
            ]}
          >
            {link.label}
            {link.children.length > 0 && (
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>

          {link.children.length > 0 && (
            <div class="absolute top-full left-0 pt-2 hidden group-hover:block">
              <ul class="bg-white/95 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg py-1 min-w-[160px]">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors rounded-md mx-1',
                        pathname === child.href
                          ? 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] font-medium'
                          : 'text-gray-700 hover:bg-gray-100',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-white/80 hover:text-white p-2 rounded-lg hover:bg-white/10 transition-colors"
      aria-label="Open menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu drawer -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden"
>
  <div id="mobile-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="absolute right-0 top-0 h-full w-64 bg-gray-900 shadow-2xl flex flex-col">
    <div class="flex items-center justify-between p-4 border-b border-white/10">
      <span class="text-white font-semibold">{SITE.name}</span>
      <button id="mobile-close" class="text-white/60 hover:text-white p-1">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto p-4 space-y-1">
      {NAV_LINKS.map((link) => (
        <div>
          <a href={link.href} class="block px-3 py-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 font-medium transition-colors">
            {link.label}
          </a>
          {link.children.map((child) => (
            <a href={child.href} class="block px-6 py-1.5 text-sm text-white/60 hover:text-white hover:bg-white/10 rounded-lg transition-colors mt-0.5">
              {child.label}
            </a>
          ))}
        </div>
      ))}
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const close = document.getElementById('mobile-close');

  function openMenu() { menu?.classList.remove('hidden'); }
  function closeMenu() { menu?.classList.add('hidden'); }

  btn?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
</script>
