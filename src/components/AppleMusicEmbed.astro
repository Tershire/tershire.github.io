---
interface Props {
  url: string;
  compact?: boolean;
}

const { url, compact = false } = Astro.props;

// Convert share URL to embed URL
// https://music.apple.com/kr/album/... → https://embed.music.apple.com/kr/album/...
const embedUrl = url.replace('music.apple.com/', 'embed.music.apple.com/');
const height = compact ? 175 : 450;
---

<div style="margin:2rem 0;border-radius:0.75rem;overflow:hidden;">
  <iframe
    src={embedUrl}
    width="100%"
    height={height}
    allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
    loading="lazy"
    style="border:0;display:block;background:transparent;"
  ></iframe>
</div>
